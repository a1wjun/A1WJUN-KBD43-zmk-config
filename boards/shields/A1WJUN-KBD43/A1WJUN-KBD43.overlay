#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include "A1WJUN-KBD43.dtsi"   // 引入纯物理布局

/ {
    // ========== 矩阵变换 ==========
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)
        >;
    };

    // ========== GPIO 扫描驱动 ==========
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        status = "okay";
        wakeup-source;
        diode-direction = "col2row";

        // 优化：防抖与扫描周期设为 1ms，降低输入延迟（性能优先）
        debounce-press-ms = <1>;
        debounce-release-ms = <1>;
        debounce-scan-period-ms = <1>;

        col-gpios
            = <&pro_micro 18 GPIO_ACTIVE_HIGH>
            , <&pro_micro 17 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>
            , <&pro_micro 12 GPIO_ACTIVE_HIGH>
            , <&pro_micro 11 GPIO_ACTIVE_HIGH>
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>
            , <&pro_micro  9 GPIO_ACTIVE_HIGH>
            , <&pro_micro  8 GPIO_ACTIVE_HIGH>
            , <&pro_micro  7 GPIO_ACTIVE_HIGH>
            , <&pro_micro  6 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&pro_micro 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    // ========== ZMK Studio 支持 ==========
    studio: studio {
        compatible = "zmk,studio";
        layout = <&physical_layout_0>;   // 启用布局引用，使 Studio 正常工作
    };

    // ========== chosen 节点 ==========
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout_0;   // 明确指定物理布局
    };

    // ========== 自定义行为 ==========
    behaviors {
        studio_unlock: studio_unlock {
            compatible = "zmk,behavior-studio-unlock";
            #binding-cells = <0>;
        };
    };

    // ========== 物理布局（从外部 dtsi 引入后补充 transform） ==========
    physical_layout_0: physical_layout_0 {
        status = "okay";
        transform = <&default_transform>;
        // 注意：kscan 由 chosen 统一指定，此处无需重复绑定
    };
};
